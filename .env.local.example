# ─────────────────────────────────────────────────────────────
# Tally environment variables — copy to `.env.local`.
# Firebase is REQUIRED (Google sign-in). The rest are optional.
# ─────────────────────────────────────────────────────────────

# Firebase — Google authentication. REQUIRED.
# Create a project at https://console.firebase.google.com,
# add a Web App, enable Google as a sign-in provider, then paste:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# MongoDB Atlas — the data store (server-side only, never exposed to client).
# REQUIRED. Allow Vercel/your IP in Atlas Network Access (0.0.0.0/0 for Vercel).
MONGODB_URI=

# Public base URL of the deployment (e.g. https://tally.app). Used to build
# invite links from a trusted origin instead of the spoofable request header.
# Falls back to the request origin when unset. Set this in production.
NEXT_PUBLIC_APP_URL=

# Email (invites, settlement receipts, monthly reminders) — sent via Resend.
# Create an API key at https://resend.com and verify your sending domain.
# Without a key, emails are skipped (in-app invite links still work).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Tally <noreply@your-domain.com>"

# Realtime sync (optional) — a Pusher Channels app. Group members see changes
# instantly; without it the app refreshes when it comes back into view.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Web Push notifications (optional). Generate with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Secret for the daily cron (/api/cron/daily): repeats split expenses and sends
# settle-up reminders on the 1st. Any long random string.
CRON_SECRET=

# Money Ledger's public URL (optional). When set, old /money, /wealth, /debt and
# /report links redirect there and the home screen shows a one-time notice.
NEXT_PUBLIC_MONEY_LEDGER_URL=
